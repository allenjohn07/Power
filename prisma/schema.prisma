// SAIT Outlets — relational indoor plug directory (not a geo/spatial app).
// Location = Building + floor + wing + human micro-location text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  imageUrl     String?
  createdAt    DateTime   @default(now())
  votes        PlugVote[]
  plugs        Plug[]     @relation("SubmittedPlugs")
}

/// Campus building catalog — anchor for filters, map SVG ids, and plug FKs.
model Building {
  id        Int     @id @default(autoincrement())
  code      String  @unique // e.g. "N" for Senator Burns; wings use NL, NN, etc.
  name      String
  campus    String  @default("main")
  mapSvgId  String? // Element id in public/maps/sait-campus-map.svg
  mapX      Float   @default(50) // Schematic position for "near me" (not GPS)
  mapY      Float   @default(50)
  maxFloor  Int     @default(5)
  wings     String? // Comma-separated wing prefixes when applicable
  plugs     Plug[]
}

/// One crowdsourced outlet report at a micro-location inside a building.
model Plug {
  id            Int         @id @default(autoincrement())
  buildingId    Int
  floor         String // Human label, e.g. "4th Floor" — matches filter dropdowns
  wing          String?
  exactLocation String // Prose: "Behind vending machine near CA416"
  upvotes       Int         @default(0) // Denormalized for fast feed reads
  downvotes     Int         @default(0)
  submittedById String?
  createdAt     DateTime    @default(now())
  building      Building    @relation(fields: [buildingId], references: [id])
  submittedBy   User?       @relation("SubmittedPlugs", fields: [submittedById], references: [id], onDelete: SetNull)
  images        PlugImage[]
  votes         PlugVote[]
}

/// One Works/Broken vote per user per plug — integrity via @@unique.
model PlugVote {
  id     Int      @id @default(autoincrement())
  userId String
  plugId Int
  vote   VoteKind
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plug   Plug     @relation(fields: [plugId], references: [id], onDelete: Cascade)

  @@unique([userId, plugId])
}

enum VoteKind {
  UP
  DOWN
}

model PlugImage {
  id        Int    @id @default(autoincrement())
  plugId    Int
  sortOrder Int    @default(0)
  url       String // Blob URL or /uploads/plugs/... after POST /api/upload
  plug      Plug   @relation(fields: [plugId], references: [id], onDelete: Cascade)
}
